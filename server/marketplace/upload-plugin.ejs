    padding: 0.25rem;
    border-radius: 0.25rem;
    transition: background 0.2s;
}

.remove-file:hover {
    background: #fee2e2;
}

.form-row {
    margin-bottom: 1.5rem;
}

.form-row label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: #1e293b;
    margin-bottom: 0.5rem;
}

.form-row textarea {
    width: 100%;
    min-height: 120px;
    padding: 0.75rem;
