<% 
var bodyContent = `
<main class="main">
    <div class="upload-flex-container">
        <div class="requirements-section card-style">
            <h3><i class="fas fa-clipboard-check"></i> Plugin Requirements</h3>
            <ul>
                <li><i class="fas fa-check-circle"></i> Plugin must be in ZIP format</li>
                <li><i class="fas fa-check-circle"></i> Must contain a valid <code>package.json</code> file</li>
                <li><i class="fas fa-check-circle"></i> Must have a main component file (JavaScript)</li>
                <li><i class="fas fa-check-circle"></i> File size should not exceed 100KB</li>
                <li><i class="fas fa-check-circle"></i> Follow the standard component structure</li>
            </ul>
        </div>        <div class="upload-plugin-card card-style">
            <div class="upload-header">
                <h2><i class="fas fa-cloud-upload-alt"></i> Upload a New Plugin</h2>
                <p>Share your component with the Zero Components community</p>
                
                <!-- Coming Soon Notice -->
                <div class="coming-soon-notice">
                    <div class="coming-soon-badge">
                        <i class="fas fa-construction"></i>
                        Coming Soon
                    </div>
                    <p class="coming-soon-text">
                        Component uploading is currently in development! We're working on a streamlined process to allow developers to easily share their components with the community. 
                        <br><br>
                        <strong>Stay tuned for updates on this exciting feature.</strong>
                    </p>
                </div>
            </div>
            <form id="pluginUploadForm" enctype="multipart/form-data" style="opacity: 0.6; pointer-events: none;">
                <div class="upload-area" id="uploadArea">
                    <div class="upload-area-content" id="uploadAreaContent">
                        <i class="fas fa-cloud-upload-alt upload-icon"></i>
                        <p class="upload-text">Drag and drop your ZIP file here</p>
                        <p class="upload-text-sub">or</p>
                        <label for="pluginZip" class="upload-button">Browse Files</label>
                        <input type="file" id="pluginZip" name="plugin" accept=".zip" required hidden />
                    </div>
                    <div class="file-info" id="fileInfo" style="display: none;">
                        <i class="fas fa-file-archive"></i>
                        <span class="file-name" id="fileName"></span>
                        <span class="file-size" id="fileSize"></span>
                        <button type="button" class="remove-file" id="removeFile">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="form-row">
                    <label for="notes"><i class="fas fa-sticky-note"></i> Additional Notes</label>
                    <textarea id="notes" name="notes" placeholder="Describe your plugin, its features, or any special instructions..."></textarea>
                </div>
                <div class="form-row button-container">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-cloud-upload-alt"></i> Upload Plugin
                    </button>
                    <span class="btn-description">Maximum file size: 100KB</span>
                </div>
                <div id="uploadStatus" class="upload-status">
                    <div class="progress-bar" style="display: none;">
                        <div class="progress-fill"></div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</main>
<script>
const form = document.getElementById('pluginUploadForm');
const uploadArea = document.getElementById('uploadArea');
const uploadAreaContent = document.getElementById('uploadAreaContent');
const fileInfo = document.getElementById('fileInfo');
const fileName = document.getElementById('fileName');
const fileSize = document.getElementById('fileSize');
const removeFileBtn = document.getElementById('removeFile');
const fileInput = document.getElementById('pluginZip');
const statusDiv = document.getElementById('uploadStatus');
const progressBar = statusDiv.querySelector('.progress-bar');
const progressFill = statusDiv.querySelector('.progress-fill');

// Format file size
function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// Handle file selection
function handleFileSelect(file) {
    if (!file) return;
    
    // Check file type
    if (!file.name.toLowerCase().endsWith('.zip')) {
        showStatus('error', 'Please select a ZIP file');
        return;
    }
    
    // Check file size (100KB limit)
    if (file.size > 100 * 1024) {
        showStatus('error', 'File size exceeds 100KB limit');
        return;
    }

    // Update UI
    fileName.textContent = file.name;
    fileSize.textContent = formatFileSize(file.size);
    uploadAreaContent.style.display = 'none';
    fileInfo.style.display = 'flex';
    clearStatus();
}

// Show status message
function showStatus(type, message) {
    const statusMessage = document.createElement('div');
    statusMessage.className = 'status-message ' + type;
    statusMessage.textContent = message;
    statusDiv.innerHTML = '';
    statusDiv.appendChild(statusMessage);
}

// Clear status
function clearStatus() {
    statusDiv.innerHTML = '';
    progressBar.style.display = 'none';
    progressFill.style.width = '0%';
}

// Reset file input
function resetFileInput() {
    fileInput.value = '';
    uploadAreaContent.style.display = 'block';
    fileInfo.style.display = 'none';
    clearStatus();
}

// Drag and drop handlers
uploadArea.addEventListener('dragover', function(e) {
    e.preventDefault();
    uploadArea.classList.add('drag-over');
});

uploadArea.addEventListener('dragleave', function() {
    uploadArea.classList.remove('drag-over');
});

uploadArea.addEventListener('drop', function(e) {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    const file = e.dataTransfer.files[0];
    fileInput.files = e.dataTransfer.files;
    handleFileSelect(file);
});

// File input change handler
fileInput.addEventListener('change', function(e) {
    handleFileSelect(e.target.files[0]);
});

// Remove file handler
removeFileBtn.addEventListener('click', resetFileInput);

// Form submit handler
form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (!fileInput.files[0]) {
        showStatus('error', 'Please select a file to upload');
        return;
    }

    const formData = new FormData(form);
    progressBar.style.display = 'block';
    progressFill.style.width = '0%';

    try {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/marketplace/upload', true);

        // Progress handler
        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                const percentComplete = (e.loaded / e.total) * 100;
                progressFill.style.width = percentComplete + '%';
            }
        };

        // Response handler
        xhr.onload = function() {
            if (xhr.status === 200) {
                const response = JSON.parse(xhr.responseText);
                if (response.success) {
                    showStatus('success', response.message);
                    resetFileInput();
                } else {
                    showStatus('error', response.error || 'Upload failed');
                }
            } else {
                showStatus('error', 'Upload failed');
            }
        };

        // Error handler
        xhr.onerror = function() {
            showStatus('error', 'Network error occurred');
        };

        xhr.send(formData);
    } catch (err) {
        showStatus('error', 'Error: ' + err.message);
    }
});
</script>
<style>
:root {
    --primary-color: #667eea;
    --secondary-color: #f9fafb;
    --card-bg: #fff;
    --border-radius: 0.75rem;
    --box-shadow: 0 4px 16px 0 rgba(102,126,234,0.08);
    --input-border: #e5e7eb;
    --input-focus: #667eea33;
    --success: #10b981;
    --danger: #ef4444;
}
.upload-flex-container {
    display: flex;
    gap: 2rem;
    align-items: stretch;
    justify-content: center;
    flex-direction: row;
}
.card-style {
    background: var(--card-bg);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.requirements-section.card-style {
    min-width: 260px;
    max-width: 320px;
    flex: 1 1 320px;
    margin-bottom: 0;
    border: 1px solid #e2e8f0;
}
.upload-plugin-card.card-style {
    flex: 2 1 400px;
    max-width: 600px;
    margin: 0;
}
.upload-plugin-card {
    background: var(--card-bg);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
    max-width: 600px;
    margin: 3rem auto 2rem auto;
    padding: 2.5rem;
}

.upload-header {
    text-align: center;
    margin-bottom: 2rem;
}

.upload-header h2 {
    color: var(--primary-color);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
}

.upload-header p {
    color: #6b7280;
    font-size: 1.1rem;
}

.coming-soon-notice {
    background: linear-gradient(135deg, #fef3cd 0%, #fde68a 100%);
    border: 2px solid #f59e0b;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-top: 1.5rem;
    text-align: center;
}

.coming-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f59e0b;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 1rem;
}

.coming-soon-badge i {
    font-size: 1rem;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

.coming-soon-text {
    color: #92400e;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
}

.requirements-section {
    background: #f8fafc;
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid #e2e8f0;
}

.requirements-section h3 {
    color: #1e293b;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.requirements-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.requirements-section li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #475569;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
}

.requirements-section li i {
    color: #10b981;
}

.requirements-section code {
    background: #e2e8f0;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
