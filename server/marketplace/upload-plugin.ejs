.button-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
}

.btn-description {
    font-size: 0.8rem;
    font-weight: 400;
    color: #6b7280;
    text-align: center;
}

.upload-status {
    margin-top: 1rem;
}

.progress-bar {
    background: #e2e8f0;
    border-radius: 1rem;
    height: 0.5rem;
    overflow: hidden;
}

.progress-fill {
    background: var(--primary-color);
    height: 100%;
    width: 0;
    transition: width 0.3s ease;
}

.status-message {
    text-align: center;
    margin-top: 0.5rem;
    font-size: 0.95rem;
}

.status-message.success {
    color: #10b981;
}

.status-message.error {
    color: #ef4444;
}

/* Form disabled state for coming soon */
form[style*="pointer-events: none"] .upload-area {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #64748b !important;
}

form[style*="pointer-events: none"] .upload-area * {
    color: #94a3b8 !important;
}

form[style*="pointer-events: none"] .upload-button {
    background: #cbd5e1 !important;
    cursor: not-allowed !important;
}

form[style*="pointer-events: none"] .btn.btn-primary {
    background: #cbd5e1 !important;
    cursor: not-allowed !important;
}

@media (max-width: 900px) {
    .upload-flex-container {
        flex-direction: column;
        gap: 1.5rem;
        align-items: stretch;
    }
    .requirements-section.card-style, .upload-plugin-card.card-style {
        max-width: 100%;
        min-width: 0;
        margin: 0 auto;
        padding: 1.5rem;
    }
}
</style>
`;
%>
<%- include('baselayout', { body: bodyContent }) %>
