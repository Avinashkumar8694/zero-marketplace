<%- include('baselayout.ejs', { title: 'Zero Components Marketplace - Discover & Share Plugins' }) %>

<main class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Supercharge Your Development with Zero Components</h1>
            <p class="hero-subtitle">Discover, share, and integrate powerful plugins to build better applications faster</p>
            <div class="hero-cta">
                <a href="/marketplace/plugins" class="btn btn-primary">Browse Plugins</a>
                <a href="/marketplace/upload" class="btn btn-outline">Share Your Plugin</a>
            </div>
            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-number">500+</span>
                    <span class="stat-label">Active Plugins</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">10K+</span>
                    <span class="stat-label">Downloads</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">2K+</span>
                    <span class="stat-label">Developers</span>
                </div>
            </div>
        </div>
        <div class="hero-image">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original-wordmark.svg" alt="Components Illustration" class="floating-animation">
        </div>
    </section>

    <!-- Featured Plugins Section -->
    <section class="featured-plugins">
        <h2>Featured Plugins</h2>
        <div class="plugins-grid">
            <div class="plugin-card">
                <div class="plugin-icon">
                    <i class="fas fa-palette"></i>
                </div>
                <h3>Theme Builder</h3>
                <p>Create and customize themes with an intuitive visual interface</p>
                <div class="plugin-meta">
                    <span><i class="fas fa-download"></i> 2.5k</span>
                    <span><i class="fas fa-star"></i> 4.8</span>
                </div>
            </div>
            <div class="plugin-card">
                <div class="plugin-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Data Visualizer</h3>
                <p>Transform your data into beautiful, interactive charts</p>
                <div class="plugin-meta">
                    <span><i class="fas fa-download"></i> 1.8k</span>
                    <span><i class="fas fa-star"></i> 4.7</span>
                </div>
            </div>
            <div class="plugin-card">
                <div class="plugin-icon">
                    <i class="fas fa-table"></i>
                </div>
                <h3>Grid Master</h3>
                <p>Advanced data grid with sorting, filtering, and custom rendering</p>
                <div class="plugin-meta">
                    <span><i class="fas fa-download"></i> 3.2k</span>
                    <span><i class="fas fa-star"></i> 4.9</span>
                </div>
            </div>
        </div>
        <div class="section-cta">
            <a href="/marketplace/plugins" class="btn btn-secondary">View All Plugins</a>
        </div>
    </section>

    <!-- Benefits Section -->
    <section class="benefits">
        <h2>Why Choose Zero Components?</h2>
        <div class="benefits-grid">
            <div class="benefit-card">
                <i class="fas fa-bolt"></i>
                <h3>Quick Integration</h3>
                <p>Install and use plugins with just a few lines of code</p>
            </div>
            <div class="benefit-card">
                <i class="fas fa-shield-alt"></i>
                <h3>Secure & Reliable</h3>
                <p>All plugins are verified and tested for security</p>
            </div>
            <div class="benefit-card">
                <i class="fas fa-code"></i>
                <h3>Developer Friendly</h3>
                <p>Comprehensive documentation and examples</p>
            </div>
            <div class="benefit-card">
                <i class="fas fa-users"></i>
                <h3>Active Community</h3>
                <p>Get help and share knowledge with other developers</p>
            </div>
        </div>
    </section>

    <!-- Call to Action Section -->
    <section class="cta-section">
        <div class="cta-content">
            <h2>Ready to Transform Your Development?</h2>
            <p>Join thousands of developers who are building better applications with Zero Components</p>
            <div class="cta-buttons">
                <a href="/marketplace/plugins" class="btn btn-primary">Get Started</a>
                <a href="/marketplace/docs" class="btn btn-outline">Read Documentation</a>
            </div>
        </div>
    </section>
</main>

<script src="/marketplace/script.js"></script>