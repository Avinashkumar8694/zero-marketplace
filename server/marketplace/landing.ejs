// Register plugin with security validation
class SecurePlugin extends RendererComponent {
    @RendererAttribute({
        type: AttributeType.String,
        validate: (value) => {
            // Built-in XSS prevention
            return sanitizeInput(value);
        }
    })
    userInput: string;

    @RendererAttribute({
        type: AttributeType.Object,
        validateSchema: {
            required: ['id', 'token'],
            properties: {
                id: { type: 'string' },
                token: { type: 'string' }
            }
        }
    })
    credentials: object;
}
                    </code></pre>
