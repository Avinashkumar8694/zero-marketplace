<main class="plans-page">
    <!-- Hero Section -->
    <section class="plans-hero">
        <div class="hero-content">
            <h1>Choose Your Plan</h1>
            <p class="hero-subtitle">Start building amazing applications with Zero Components. Currently free for everyone!</p>
        </div>
    </section>    <!-- Pricing Cards -->
    <section class="pricing-section">
        <div class="pricing-container">
            <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
                <% plans.forEach(plan => { %>
                    <% 
                        const isComingSoon = plan.featureFlag && typeof features !== 'undefined' && !features[plan.featureFlag];
                        const currentAction = isComingSoon ? plan.action.comingSoon : plan.action.enabled || plan.action;
                    %>
                    
                    <!-- <%= plan.name %> Card -->
                    <div class="pricing-card <%= plan.type %> <% if (isComingSoon) { %>coming-soon<% } %>">
                        <% if (plan.badge) { %>
                        <div class="plan-badge">
                            <i class="<%= plan.badge.icon %>"></i>
                            <span><%= plan.badge.text %></span>
                        </div>
                        <% } %>
                        
                        <div class="plan-header">
                            <h3><%= plan.name %></h3>
                            <div class="price">
                                <% if (plan.price.currency) { %>
                                <span class="currency"><%= plan.price.currency %></span>
                                <% } %>
                                <span class="amount"><%= plan.price.amount %></span>
                                <% if (plan.price.period) { %>
                                <span class="period"><%= plan.price.period %></span>
                                <% } %>
                            </div>
                            <p class="plan-description"><%= plan.description %></p>
                            
                            <% if (plan.showBetaNotice) { %>
                            <div class="beta-notice">
                                <i class="fas fa-info-circle"></i>
                                <span>Currently in beta - this plan may change as we evolve</span>
                            </div>
                            <% } %>
                        </div>
                        
                        <div class="plan-features">
                            <h4><%= plan.featuresPrefix || 'What\'s included:' %></h4>
                            <ul>
                                <% plan.features.forEach(feature => { %>
                                <li><i class="<%= feature.icon %>"></i> <%= feature.text %></li>
                                <% }); %>
                            </ul>
                        </div>
                        
                        <% if (plan.showBetaDisclaimer) { %>
                        <div class="beta-disclaimer">
                            <h5><i class="fas fa-exclamation-triangle"></i> Beta Version Notice</h5>
                            <p>This is a beta version of our marketplace. Features and pricing plans may change as we gather feedback and improve the platform. Current users will be notified of any changes in advance.</p>
                        </div>
                        <% } %>
                        
                        <div class="plan-action">
                            <% if (currentAction.type === 'current') { %>
                                <button class="btn-plan current-plan" disabled>
                                    <i class="<%= currentAction.icon %>"></i>
                                    <%= currentAction.text %>
                                </button>
                            <% } else if (currentAction.type === 'coming-soon') { %>
                                <button class="btn-plan coming-soon-btn" disabled>
                                    <i class="<%= currentAction.icon %>"></i>
                                    <%= currentAction.text %>
                                </button>
                            <% } else if (currentAction.type === 'contact') { %>
                                <button class="btn-plan contact-btn">
                                    <i class="<%= currentAction.icon %>"></i>
                                    <%= currentAction.text %>
                                </button>
                            <% } else { %>
                                <button class="btn-plan">
                                    <i class="<%= currentAction.icon %>"></i>
                                    <%= currentAction.text %>
                                </button>
                            <% } %>
                            <p class="plan-note"><%= currentAction.note %></p>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <!-- Fallback content if plans data is not available -->
                <div class="pricing-card featured">
                    <div class="plan-header">
                        <h3>Plans Coming Soon</h3>
                        <p class="plan-description">We're working on our pricing plans. Stay tuned for updates!</p>
                    </div>
                </div>
            <% } %>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="faq-container">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-grid">                <div class="faq-item">
                    <h4>Is the free plan really free forever?</h4>
                    <p>Yes! Our free plan gives you access to all current features with no time limits. However, as we're currently in beta, some features and plans may evolve based on user feedback.</p>
                </div>
                <div class="faq-item">
                    <h4>What does "beta version" mean?</h4>
                    <p>We're actively developing and improving the marketplace. While all current features are fully functional, we may introduce changes, improvements, or new pricing tiers as we grow. All users will be notified in advance of any significant changes.</p>
                </div>
                <div class="faq-item">
                    <h4>Can I use Zero Components for commercial projects?</h4>
                    <p>Absolutely! All our components can be used in commercial projects without any restrictions, even on the free plan.</p>
                </div>
                <div class="faq-item">
                    <h4>When will paid plans be available?</h4>
                    <p>We're working on enhanced features for paid plans. Stay tuned for announcements about Pro and Enterprise offerings.</p>
                </div>
                <div class="faq-item">
                    <h4>Will I be grandfathered if pricing changes?</h4>
                    <p>We value our early users! Any pricing changes will be communicated well in advance, and we'll work to ensure a smooth transition for existing users with fair and reasonable terms.</p>
                </div>                <div class="faq-item">
                    <h4>Do I need to provide a credit card?</h4>
                    <p>No credit card required! Simply start using Zero Components immediately with our free plan.</p>
                </div>
                <% if (typeof features !== 'undefined' && !features.UPLOAD_ENABLED) { %>
                <div class="faq-item">
                    <h4>How do I upload my own components?</h4>
                    <p>Component uploading is a coming soon feature! We're working on a streamlined process to allow developers to easily share their components with the community. Stay tuned for updates on this exciting feature.</p>
                </div>
                <% } else { %>
                <div class="faq-item">
                    <h4>How do I upload my own components?</h4>
                    <p>You can easily upload your components using our upload form! Just visit the <a href="/marketplace/upload">Upload Your Plugins</a> page, prepare your component as a ZIP file with a valid package.json, and follow the upload process.</p>
                </div>
                <% } %>
                <div class="faq-item">
                    <h4>What kind of support is available?</h4>
                    <p>Currently, we offer community support through our documentation and GitHub issues. Priority support will be available with paid plans.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Join thousands of developers building amazing applications with Zero Components</p>
            <div class="cta-buttons">
                <a href="/marketplace" class="btn btn-primary">
                    <i class="fas fa-rocket"></i>
                    Browse Components
                </a>
                <a href="/marketplace/upload" class="btn btn-outline">
                    <i class="fas fa-upload"></i>
                    Share Your Work
                </a>
            </div>
        </div>
    </section>
</main>

<style>
.plans-page {
    min-height: calc(100vh - 80px);
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #333;
}

/* Hero Section */
.plans-hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 80px 20px;
    text-align: center;
}

.hero-content h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(45deg, #fff, #e0e6ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 1.3rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Pricing Section */
.pricing-section {
    padding: 80px 20px;
    background: #f8fafc;
}

.pricing-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    align-items: start;
}

.pricing-card {
    background: white;
    border-radius: 20px;
    padding: 40px 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 2px solid transparent;
}

.pricing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.15);
}

.pricing-card.featured {
    border-color: #667eea;
    transform: scale(1.05);
}

.pricing-card.coming-soon {
    opacity: 0.8;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
}

.pricing-card.enterprise {
    background: linear-gradient(135deg, #434343 0%, #000000 100%);
    color: white;
}

.plan-badge {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #ff9500 0%, #ff6b35 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 2px 10px rgba(255, 149, 0, 0.3);
}

.plan-header {
    text-align: center;
    margin-bottom: 30px;
}

.plan-header h3 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.beta-notice {
    background: rgba(255, 193, 7, 0.1);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 8px;
    padding: 8px 12px;
    margin: 15px 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: #856404;
}

.beta-notice i {
    color: #ffc107;
}

.price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    margin-bottom: 15px;
}

.currency {
    font-size: 1.5rem;
    font-weight: 600;
}

.amount {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 0 5px;
}

.period {
    font-size: 1.2rem;
    color: #666;
}

.plan-description {
    color: #666;
    font-size: 1.1rem;
    line-height: 1.5;
}

.enterprise .plan-description {
    color: #ccc;
}

.plan-features {
    margin-bottom: 30px;
}

.plan-features h4 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: #333;
}

.enterprise .plan-features h4 {
    color: white;
}

.plan-features ul {
    list-style: none;
    padding: 0;
}

.plan-features li {
    padding: 8px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1rem;
}

.plan-features li i {
    color: #667eea;
    font-size: 1.1rem;
    width: 20px;
}

.enterprise .plan-features li i {
    color: #ffd700;
}

.coming-soon .plan-features li i {
    color: #999;
}

.plan-action {
    text-align: center;
}

.btn-plan {
    width: 100%;
    padding: 15px 30px;
    border: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 15px;
}

.btn-plan:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

.current-plan {
    background: #e8f5e8;
    color: #2d5a2d;
    cursor: default;
}

.coming-soon-btn {
    background: #f0f0f0;
    color: #666;
    cursor: not-allowed;
}

.contact-btn {
    background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
    color: #333;
}

.plan-note {
    font-size: 0.9rem;
    color: #666;
    margin: 0;
}

.enterprise .plan-note {
    color: #ccc;
}

/* FAQ Section */
.faq-section {
    padding: 80px 20px;
    background: white;
}

.faq-container {
    max-width: 1000px;
    margin: 0 auto;
}

.faq-container h2 {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 50px;
    color: #333;
}

.faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 30px;
}

.faq-item {
    padding: 25px;
    background: #f8fafc;
    border-radius: 15px;
    border-left: 4px solid #667eea;
}

.faq-item h4 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: #333;
}

.faq-item p {
    color: #666;
    line-height: 1.6;
}

.faq-item a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
}

.faq-item a:hover {
    text-decoration: underline;
}

/* CTA Section */
.cta-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    text-align: center;
}

.cta-content h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 20px;
}

.cta-content p {
    font-size: 1.3rem;
    margin-bottom: 40px;
    opacity: 0.9;
}

.cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 15px 30px;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
}

.btn-primary {
    background: white;
    color: #667eea;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(255,255,255,0.3);
}

.btn-outline {
    background: transparent;
    color: white;
    border: 2px solid white;
}

.btn-outline:hover {
    background: white;
    color: #667eea;
    transform: translateY(-2px);
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero-content h1 {
        font-size: 2.5rem;
    }
    
    .hero-subtitle {
        font-size: 1.1rem;
    }
    
    .pricing-container {
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .pricing-card.featured {
        transform: none;
    }
    
    .faq-grid {
        grid-template-columns: 1fr;
    }
    
    .cta-content h2 {
        font-size: 2rem;
    }
    
    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }
    
    .btn {
        width: 100%;
        max-width: 300px;
    }
}

@media (max-width: 480px) {
    .pricing-card {
        padding: 30px 20px;
    }
    
    .amount {
        font-size: 2.5rem;
    }
    
    .plans-hero {
        padding: 60px 20px;
    }
    
    .pricing-section {
        padding: 60px 20px;
    }
    
    .faq-section {
        padding: 60px 20px;
    }
    
    .cta-section {
        padding: 60px 20px;
    }
}
</style>

<script>
// Add some interactivity
document.addEventListener('DOMContentLoaded', function() {
    // Contact sales button
    const contactBtn = document.querySelector('.contact-btn');
    if (contactBtn) {
        contactBtn.addEventListener('click', function() {
            alert('Contact sales feature coming soon! For now, please reach out via GitHub issues or community forums.');
        });
    }
    
    // Add smooth scrolling to anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
});
</script>
