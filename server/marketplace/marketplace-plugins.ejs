<%- include('baselayout', { body: `
<div class="notification success" id="notification" style="display: none;">
    <i class="fas fa-check-circle"></i>
    <span>Install command ready to be pasted in your terminal</span>
    <button class="notification-close" onclick="hideNotification()">
        <i class="fas fa-times"></i>
    </button>
</div>

<main class="main">
    <div class="search-container">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search for a plugin" />
        </div>
    </div>
    <div class="plugin-grid" id="pluginGrid">
        <div class="loading" id="loading">
            <i class="fas fa-spinner fa-spin"></i>
            <span>Loading plugins...</span>
        </div>
    </div>
    <div class="pagination" id="pagination" style="display: none;">
        <button class="pagination-btn" id="prevBtn" onclick="changePage(-1)">
            <i class="fas fa-chevron-left"></i>
        </button>
        <span class="pagination-info" id="paginationInfo">1</span>
        <button class="pagination-btn" id="nextBtn" onclick="changePage(1)">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
</main>

<div class="modal" id="pluginModal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div class="plugin-header">
                <div class="plugin-icon">
                    <i class="fas fa-puzzle-piece"></i>
                </div>
                <div class="plugin-info">
                    <h2 id="modalTitle">Plugin Name</h2>
                    <p id="modalDescription">Plugin description</p>
                    <div class="plugin-meta">
                        <span class="version" id="modalVersion">v1.0.0</span>
                        <div class="version-selector" id="versionSelector" style="display: none;">
                            <label for="versionDropdown">Version:</label>
                            <select id="versionDropdown" onchange="switchVersion()">
                                <!-- Options populated dynamically -->
                            </select>
                        </div>
                        <span class="author" id="modalAuthor">Author</span>
                        <span class="verified" id="modalVerified">
                            <i class="fas fa-check-circle"></i>
                            Plugin verified by Zero Components
                        </span>
                    </div>
                </div>
            </div>
            <button class="modal-close" onclick="closeModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="plugin-actions">
                <button class="btn btn-primary" id="modalInstallBtn" onclick="copyInstallCommand()">
                    <i class="fas fa-download"></i>
                    Copy install command
                </button>
                <button class="btn btn-secondary" id="showVersionsBtn" onclick="toggleVersionSelector()">
                    <i class="fas fa-code-branch"></i>
                    Show All Versions
                </button>
            </div>
            <div class="plugin-details">
                <div class="detail-tabs">
                    <button class="tab-btn active" onclick="showTab('overview')">Overview</button>
                    <button class="tab-btn" onclick="showTab('readme')">Documentation</button>
                    <button class="tab-btn" onclick="showTab('details')">Details</button>
                </div>
                <div class="tab-content">
                    <div class="tab-pane active" id="overviewTab">
                        <div class="overview-content">
                            <h3>Features</h3>
                            <div id="pluginFeatures"></div>
                            <h3>Keywords</h3>
                            <div class="keywords" id="pluginKeywords"></div>
                            <h3>Quick Example</h3>
                            <div class="code-example">
                                <pre><code id="pluginExample"></code></pre>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="readmeTab">
                        <div class="readme-content" id="readmeContent">
                            <div class="loading">
                                <i class="fas fa-spinner fa-spin"></i>
                                <span>Loading documentation...</span>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="detailsTab">
                        <div class="details-content">
                            <table class="details-table">
                                <tr>
                                    <td>Package Name</td>
                                    <td id="detailPackageName"></td>
                                </tr>
                                <tr>
                                    <td>Version</td>
                                    <td id="detailVersion"></td>
                                </tr>
                                <tr>
                                    <td>Element Selector</td>
                                    <td id="detailSelector"></td>
                                </tr>
                                <tr>
                                    <td>Group</td>
                                    <td id="detailGroup"></td>
                                </tr>
                                <tr>
                                    <td>License</td>
                                    <td id="detailLicense"></td>
                                </tr>
                                <tr>
                                    <td>Main File</td>
                                    <td id="detailMainFile"></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/marketplace/script.js"></script>
<script>
    // Open upload page on button click
    const submitBtn = document.querySelector('.header-actions .btn.btn-primary');
    if (submitBtn) {
        submitBtn.addEventListener('click', function(e) {
            e.preventDefault();
            window.location.href = '/marketplace/upload';
        });
    }
</script>
` }) %>
