# Server Configuration
PORT=9000
API_BASE_URL=https://marketplace.zero.org.in
BASE_PATH=

# Component Settings
COMPONENTS_DIR=packages
DEFAULT_GROUP=Components
DEFAULT_LICENSE=MIT

# Storage Settings
UPLOAD_DIR=server/uploads
TEMP_DIR=server/temp

# CORS Settings
CORS_ORIGIN=*
CORS_METHODS=GET,POST,DELETE
CORS_HEADERS=Content-Type

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600


# Feature Flags
# Controls which features are enabled or disabled
# Set to 'true' to enable, 'false' or omit to disable

# Core marketplace functionality
# Upload functionality - Controls component upload feature
FEATURE_UPLOAD_ENABLED=false

# Plans/pricing functionality - Controls subscription plans page and overall pricing system
FEATURE_PLANS_ENABLED=false

# Individual plan availability - Controls specific pricing plans
FEATURE_FREE_PLAN_ENABLED=true
FEATURE_PRO_PLAN_ENABLED=false
FEATURE_ENTERPRISE_PLAN_ENABLED=false

# Plan-specific UI features (fine-grained control over plan display elements)
FEATURE_PLAN_BADGES_ENABLED=true
FEATURE_PLAN_BETA_NOTICES_ENABLED=true
FEATURE_PLAN_CONTACT_SALES_ENABLED=true

# Core marketplace features
# Marketplace browsing - Controls main marketplace functionality (default: true)
FEATURE_MARKETPLACE_ENABLED=true

# Component search and filtering - Controls search functionality (default: true)
FEATURE_SEARCH_ENABLED=true

# User and admin features
# User authentication features - Controls login/register functionality and profile display
FEATURE_AUTH_ENABLED=false

# Profile features - Controls user profile functionality
FEATURE_PROFILE_ENABLED=false

# Admin features - Controls administrative functionality
FEATURE_ADMIN_ENABLED=false

# Analytics and monitoring
# Component analytics and stats - Controls analytics dashboard
FEATURE_ANALYTICS_ENABLED=false

# Support and help features
# Support features - Controls support/help documentation and FAQ sections
FEATURE_SUPPORT_ENABLED=false

# Experimental features
# Beta features - Controls experimental features and beta functionality
FEATURE_BETA_ENABLED=false

