# Server Configuration
PORT=9000
API_BASE_URL=http://localhost:9000
BASE_PATH=

# Component Settings
COMPONENTS_DIR=packages
DEFAULT_GROUP=Components
DEFAULT_LICENSE=MIT

# Storage Settings
UPLOAD_DIR=server/uploads
TEMP_DIR=server/temp

# CORS Settings
CORS_ORIGIN=*
CORS_METHODS=GET,POST,DELETE
CORS_HEADERS=Content-Type

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

# Feature Flags
# Controls which features are enabled or disabled
# Set to 'true' to enable, 'false' or omit to disable

# Upload functionality - Controls component upload feature
FEATURE_UPLOAD_ENABLED=false

# Plans/pricing functionality - Controls subscription plans page
FEATURE_PLANS_ENABLED=false

# Individual plan availability - Controls specific pricing plans
FEATURE_PRO_PLAN_ENABLED=false
FEATURE_ENTERPRISE_PLAN_ENABLED=false

# Marketplace browsing - Controls main marketplace functionality (default: true)
FEATURE_MARKETPLACE_ENABLED=true

# User authentication features - Controls login/register functionality
FEATURE_AUTH_ENABLED=false

# Component search and filtering - Controls search functionality (default: true)
FEATURE_SEARCH_ENABLED=true

# Component analytics and stats - Controls analytics dashboard
FEATURE_ANALYTICS_ENABLED=false

# Admin features - Controls administrative functionality
FEATURE_ADMIN_ENABLED=false

# Beta features - Controls experimental features
FEATURE_BETA_ENABLED=false
