{
  "name": "zero-panel-layout",
  "version": "1.0.0",
  "description": "Responsive panel layout component with 1-4 column options",
  "main": "zero-panel-layout.js",
  "type": "module",
  "keywords": [
    "lit",
    "web-component",
    "layout",
    "grid",
    "panel",
    "zero-components"
  ],
  "author": "Zero Components",
  "license": "MIT",
  "zero": {
    "component": true,
    "category": "Layout",
    "components": [
      {
        "componentName": "zero-expansion-panel",
        "title": "Expansion Panel",
        "version": "1.0.0",
        "elementSelector": "zero-expansion-panel-1.0.0",
        "jsEntry": "zero-panel-suite.ts",
        "tags": [
          "layout",
          "panel",
          "expansion",
          "accordion"
        ],
        "category": "layout",
        "group": "Content Block",
        "properties": [
          {
            "name": "label",
            "type": "string",
            "defaultValue": "Expansion Panel"
          },
          {
            "name": "icon",
            "type": "string",
            "defaultValue": "⚡"
          },
          {
            "name": "expanded",
            "type": "boolean",
            "defaultValue": true
          },
          {
            "name": "expandable",
            "type": "boolean",
            "defaultValue": true
          },
          {
            "name": "backgroundColor",
            "type": "string",
            "defaultValue": "#ffffff"
          },
          {
            "name": "borderColor",
            "type": "string",
            "defaultValue": "#e2e8f0"
          },
          {
            "name": "borderRadius",
            "type": "string",
            "defaultValue": "12px"
          },
          {
            "name": "headerBg",
            "type": "string",
            "defaultValue": "#f8fafc"
          },
          {
            "name": "headerColor",
            "type": "string",
            "defaultValue": "#1e293b"
          },
          {
            "name": "padding",
            "type": "string",
            "defaultValue": "16px"
          }
        ],
        "studioTemplate": {
          "kind": "panel",
          "slots": [
            {
              "id": "default",
              "label": "Panel Content",
              "dropzone": true,
              "anchor": "content",
              "accepts": [
                "zero-section"
              ]
            }
          ],
          "emptyText": "Drag and Drop Elements here",
          "badges": [
            "Expansion"
          ]
        },
        "events": [],
        "slots": [
          "default"
        ],
        "lifecycleHooks": [
          "onInit",
          "onDestroy",
          "onChanges",
          "afterRender"
        ],
        "publishableAsNode": true,
        "source": "marketplace"
      },
      {
        "componentName": "zero-tab-panel",
        "title": "Tab Panel",
        "version": "1.0.0",
        "elementSelector": "zero-tab-panel-1.0.0",
        "jsEntry": "zero-panel-suite.ts",
        "tags": [
          "layout",
          "panel",
          "tabs"
        ],
        "category": "layout",
        "group": "Content Block",
        "properties": [
          {
            "name": "tabs",
            "type": "string",
            "defaultValue": "Tab 1, Tab 2"
          },
          {
            "name": "activeIndex",
            "type": "number",
            "defaultValue": 0
          },
          {
            "name": "backgroundColor",
            "type": "string",
            "defaultValue": "#ffffff"
          },
          {
            "name": "borderColor",
            "type": "string",
            "defaultValue": "#e2e8f0"
          },
          {
            "name": "borderRadius",
            "type": "string",
            "defaultValue": "12px"
          },
          {
            "name": "headerBg",
            "type": "string",
            "defaultValue": "#f8fafc"
          },
          {
            "name": "activeTabColor",
            "type": "string",
            "defaultValue": "#0e5aed"
          },
          {
            "name": "padding",
            "type": "string",
            "defaultValue": "16px"
          }
        ],
        "studioTemplate": {
          "kind": "panel",
          "slots": [
            {
              "id": "tab-1",
              "label": "Tab 1 Content",
              "dropzone": true,
              "anchor": "tabs",
              "accepts": [
                "zero-section"
              ]
            },
            {
              "id": "tab-2",
              "label": "Tab 2 Content",
              "dropzone": true,
              "anchor": "tabs",
              "accepts": [
                "zero-section"
              ]
            }
          ],
          "emptyText": "Drag and Drop Elements here",
          "badges": [
            "Tabs"
          ]
        },
        "events": [
          "tabchange"
        ],
        "slots": [
          "tab-1",
          "tab-2"
        ],
        "lifecycleHooks": [
          "onInit",
          "onDestroy",
          "onChanges",
          "afterRender"
        ],
        "publishableAsNode": true,
        "source": "marketplace"
      }
    ],
    "features": [
      "Responsive Columns",
      "Total Slot Control",
      "Equal Distribution",
      "Directional Flow",
      "Expandable Header"
    ]
  }
}